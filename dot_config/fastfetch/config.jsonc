{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "chafa",
        "source": "/home/lanrhyme/.config/fastfetch/avatar.png",
        "width": 40,
        "height": 19,
        "padding": { "top": 2, "right": 2 }
    },
    "display": {
        "separator": "  ",
        "disableLinewrap": true,
        "color": {
            "keys": "#afac9c",
            "title": "#f2f2f2"
        }
    },
    "modules": [
        { "type": "title", "color": { "user": "#f2f2f2", "at": "#afac9c", "host": "#a8aba0" } },
        { "type": "separator", "string": "─", "times": 40, "outputColor": "#65635e" },
        { "type": "os", "key": "   OS" },
        { "type": "kernel", "key": "   Kernel" },
        { "type": "uptime", "key": "   Uptime" },
        { "type": "packages", "key": "   Packages" },
        { "type": "shell", "key": "   Shell" },
        { "type": "terminal", "key": "   Terminal" },
        { "type": "terminalfont", "key": "  󰊕 Font" },
        { "type": "de", "key": "   DE" },
        { "type": "wm", "key": "   WM" },
        { "type": "separator", "string": "─", "times": 40, "outputColor": "#65635e" },
        { "type": "host", "key": "  󰩘 Host" },
        { "type": "cpu", "key": "   CPU" },
        { "type": "gpu", "key": "   GPU" },
        { "type": "memory", "key": "   Memory" },
        { "type": "disk", "key": "   Disk" },
        { "type": "display", "key": "  󰍙 Display" },
        { "type": "separator", "string": "─", "times": 40, "outputColor": "#65635e" },
        { "type": "localip", "key": "  󰩠 Local IP" },
        { "type": "colors" }
    ]
}
