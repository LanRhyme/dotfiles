include "./cfg/autostart.kdl"
include "./cfg/keybinds.kdl"
include "./cfg/input.kdl"
include "./cfg/display.kdl"
include "./cfg/layout.kdl"
include "./cfg/rules.kdl"
include "./cfg/misc.kdl"
include "./cfg/animation.kdl"
include "./cfg/colors.kdl"
binds {
    Mod+Print { spawn "mark-shot"; }
}

environment {
    PATH "/home/lanrhyme/.local/bin:/home/lanrhyme/.npm-global/bin:/usr/local/bin:/usr/bin:/bin"
    // 保持其他必要的 Wayland 环境变量
    XMODIFIERS "@im=fcitx"
    QT_IM_MODULE "fcitx"
    GTK_IM_MODULE "fcitx"
    SDL_IM_MODULE "fcitx"
    // 独显改为按需 prime-run 启动，不再全局强制（2026-10-29 修复桌面掉帧）
    // 面板与合成器都在核显上，全局强制独显会让每帧跨 GPU 拷贝并拖垮 144Hz 帧预算
}

input {
	mouse {
		accel-profile "flat"
	}
}

window-rule {
	match app-id=".*"
	exclude app-id="org.kde.krita"
	opacity 0.98
	draw-border-with-background false
	background-effect {
		blur true
	}
}

window-rule {
	match app-id="org.kde.krita"
	opacity 1.0
	background-effect {
		blur false
	}
}

window-rule {
	match app-id="org.gnome.Loupe"
	opacity 1.0
	background-effect {
		blur false
	}
}

window-rule {
	match app-id="menu.kando.Kando"
	open-floating true
	open-focused true
	opacity 1.0
	focus-ring { off; }
	border { off; }
	shadow { off; }
	geometry-corner-radius 0
	background-effect {
		blur false
	}
}

window-rule {
	match app-id="splayer" title=".*桌面歌词.*"
	open-floating true
	opacity 1.0
	focus-ring { off; }
	border { off; }
	shadow { off; }
	geometry-corner-radius 0
	background-effect {
		blur false
	}
}

window-rule {
	match app-id="cs2"
	match app-id="gamescope"
	opacity 1.0
	geometry-corner-radius 0
	clip-to-geometry false
	background-effect {
		blur false
	}
	open-fullscreen true
}

// 游戏窗口 (Steam / Proton): 关模糊与透明度, 独占全屏, 并打上 VRR 按需标记
// 面板与合成器都在核显上, 游戏帧从独显跨 GPU 拷回来后若再整屏高斯模糊, 144Hz 的 6.94ms 帧预算直接被吃穿
window-rule {
	match app-id="^steam_app_.*"
	match app-id="^pbz[.]exe$"
	opacity 1.0
	geometry-corner-radius 0
	clip-to-geometry false
	background-effect {
		blur false
	}
	open-fullscreen true
	variable-refresh-rate true
}

cursor {
    xcursor-theme "Bibata-Modern-Classic"
    xcursor-size 16
}

