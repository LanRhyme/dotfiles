# Ghostty Configuration — Enhanced Aesthetics & Custom Shader
font-family = JetBrainsMono Nerd Font
font-size = 12
font-feature = calt
font-feature = liga

# Window & Aesthetics
title = Ghostty@CachyOS
window-padding-x = 16
window-padding-y = 16
window-padding-balance = true
window-padding-color = background
window-decoration = true
gtk-titlebar = false
resize-overlay = never

# Scrollbar, Scrollback & Mouse
scrollbar = system
scrollback-limit = 10000
mouse-hide-while-typing = true
cursor-click-to-move = true

# Cursor & Animation
cursor-style = bar
cursor-style-blink = true
custom-shader = shaders/cursor.frag

# Copy & Paste Keybindings (Smart Ctrl+C: selection -> copy, no selection -> cancel task / SIGINT)
copy-on-select = true
keybind = ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+0=reset_font_size

# Morandi Theme generated by morandi-gen.py
config-file = theme
